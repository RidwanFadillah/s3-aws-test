<!DOCTYPE html>
<html lang="en" class="bg-gray-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>S3 File Uploader</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="font-sans antialiased">

    <div class="max-w-3xl mx-auto my-10 p-8 bg-white rounded-lg shadow-2xl">

        <h1 class="text-3xl font-bold text-gray-800 mb-6 pb-3 border-b border-gray-200">
            📦 S3 File Uploader
        </h1>

        <% if (messages.error && messages.error.length > 0) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                <span class="block sm:inline"><%= messages.error[0] %></span>
            </div>
        <% } %>
        <% if (messages.success && messages.success.length > 0) { %>
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg relative mb-6" role="alert">
                <span class="block sm:inline"><%= messages.success[0] %></span>
            </div>
        <% } %>

        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Upload File Baru</h2>

        <form action="/upload" method="post" enctype="multipart/form-data" class="flex flex-col sm:flex-row gap-4 mb-8 p-6 bg-gray-50 rounded-lg border border-gray-200">
            <input
                type="file"
                name="files"
                multiple
                required
                class="flex-grow block w-full text-sm text-gray-500
                       file:mr-4 file:py-2 file:px-4
                       file:rounded-full file:border-0
                       file:text-sm file:font-semibold
                       file:bg-blue-50 file:text-blue-700
                       hover:file:bg-blue-100 cursor-pointer"
            >
            <button
                type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg shadow-md transition duration-200 ease-in-out"
            >
                Upload
            </button>
        </form>

        <hr class="border-gray-200 my-8">

        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Daftar File di Bucket</h2>

        <ul class="space-y-3">
            <% if (files.length > 0) { %>
                <% files.forEach(file => { %>
                    <%
                        const fileUrl = `https://${bucket}.s3.${region}.amazonaws.com/${file.Key}`
                    %>
                    <li class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-4 bg-white border border-gray-200 rounded-lg shadow-sm gap-2">

                        <div class="flex-grow">
                            <a href="<%= fileUrl %>" target="_blank" class="text-blue-600 hover:underline font-medium break-all">
                                <%= file.Key %>
                            </a>
                            <span class="block text-sm text-gray-500">
                                <%= (file.Size / 1024).toFixed(2) %> KB
                            </span>
                        </div>

                        <form action="/delete" method="POST" class="flex-shrink-0">
                            <input type="hidden" name="fileKey" value="<%= file.Key %>">
                            <button
                                type="submit"
                                class="bg-red-500 hover:bg-red-700 text-white font-bold py-1 px-3 rounded-lg text-sm transition duration-200"
                                onclick="return confirm('Yakin ingin menghapus <%= file.Key %>?')"
                            >
                                Delete
                            </button>
                        </form>

                    </li>
                <% }) %>
            <% } else { %>
                <li class="text-gray-500 text-center py-4">Tidak ada file di bucket.</li>
            <% } %>
        </ul>

    </div>

</body>
</html>
